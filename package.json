{
  "name": "pixel-gym-journal",
  "productName": "Pixel Gym Journal",
  "version": "1.0.0",
  "description": "A cozy pixel-art gym progress journal that works fully offline.",
  "author": "Clark Cabillon",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "e2e": "node scripts/e2e.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.63.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.12"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
